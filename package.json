{
  "name": "@chaeco/htils",
  "version": "0.0.1",
  "description": "一个轻量级的 TypeScript 工具库，提供常用的字符串、数组、对象、文件等工具函数",
  "main": "dist/index.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "utils",
    "tools",
    "typescript",
    "string",
    "array",
    "object",
    "data-transform",
    "naming-conversion"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^20.0.0",
    "markdownlint-cli2": "^0.20.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chaeco/htils.git"
  },
  "dependencies": {
    "crypto-js": "^4.2.0"
  }
}
