{
  "name": "@chaeco/htils",
  "version": "0.0.6",
  "description": "一个轻量级的 TypeScript 工具库，提供常用的字符串、数组、对象、文件等工具函数",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && rollup -c rollup.config.mjs",
    "dev": "rollup -c rollup.config.mjs -w",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "utils",
    "tools",
    "typescript",
    "string",
    "array",
    "object",
    "data-transform",
    "naming-conversion"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^20.0.0",
    "markdownlint-cli2": "^0.20.0",
    "rollup": "^4.62.4",
    "rollup-plugin-dts": "^6.5.1",
    "tslib": "^2.8.1",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chaeco/htils.git"
  },
  "dependencies": {
    "crypto-js": "^4.2.0"
  }
}
