{
  "name": "@chaeco/htils",
  "version": "0.0.5",
  "description": "\u4e00\u4e2a\u8f7b\u91cf\u7ea7\u7684 TypeScript \u5de5\u5177\u5e93\uff0c\u63d0\u4f9b\u5e38\u7528\u7684\u5b57\u7b26\u4e32\u3001\u6570\u7ec4\u3001\u5bf9\u8c61\u3001\u6587\u4ef6\u7b49\u5de5\u5177\u51fd\u6570",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "utils",
    "tools",
    "typescript",
    "string",
    "array",
    "object",
    "data-transform",
    "naming-conversion"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^20.0.0",
    "markdownlint-cli2": "^0.20.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chaeco/htils.git"
  },
  "dependencies": {
    "crypto-js": "^4.2.0"
  }
}
